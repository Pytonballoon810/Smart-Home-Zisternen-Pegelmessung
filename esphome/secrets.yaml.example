# Copy to secrets.yaml and fill in.
# secrets.yaml is gitignored — never commit real keys.

# WiFi
wifi_ssid: "YourNetwork"
wifi_password: "YourPassword"

# Home Assistant API encryption key.
# Generate: https://esphome.io/components/api.html
# or:  openssl rand -base64 32
zisterne_pegel_api_key: "REPLACE_WITH_BASE64_KEY"

# OTA update password — any string, but use something long.
zisterne_pegel_ota_password: "REPLACE_WITH_PASSWORD"

# Fallback access point password, minimum 8 characters.
# Used only if WiFi fails; you will need it to recover the device.
zisterne_pegel_ap_password: "REPLACE_WITH_PASSWORD"